<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_digital_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@drawable/bg_widget_rounded">

    <TextClock
        android:id="@+id/widget_text_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm a"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextClock
        android:id="@+id/widget_text_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, MMM d"
        android:format24Hour="EEEE, MMM d"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_next_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clock • Tap to open"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:layout_marginTop="6dp" />
</LinearLayout>
